{
  "name": "@vigilo/core",
  "version": "0.1.0",
  "description": "Vigilo core: detecção de ataques, mascaramento e envio de eventos.",
  "license": "Apache-2.0",
  "keywords": [
    "security",
    "api-security",
    "rasp",
    "waf",
    "sql-injection",
    "nosql-injection",
    "xss",
    "path-traversal",
    "lgpd",
    "detection",
    "masking",
    "vigilo"
  ],
  "homepage": "https://github.com/wellmtx/vigilo-lib/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/wellmtx/vigilo-lib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellmtx/vigilo-lib.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/export-contract.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
