{
  "name": "@vigilo/fastify",
  "version": "0.0.1",
  "description": "Plugin Vigilo para Fastify.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vigilo/core": "workspace:*",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "fastify": "^5.12.7"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0"
  }
}
